# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    WHISPER_CACHE_DIR=/data/models \
    WHISPER_DATA_DIR=/data/jobs \
    WHISPER_DEVICE=cpu \
    WHISPER_COMPUTE_TYPE=int8
COPY server/requirements.txt /app/server/requirements.txt
# Normal hosts use their standard trust store. Managed-cloud builds can supply
# a combined CA bundle without retaining session trust material in the image.
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    python -m pip install --no-cache-dir -r /app/server/requirements.txt
RUN useradd --create-home --uid 10001 pamchenga \
    && mkdir -p /data/models /data/jobs \
    && chown -R pamchenga:pamchenga /data
COPY --chown=10001:10001 server /app/server
USER 10001:10001
VOLUME ["/data"]
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
    CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8000')+'/api/transcriptions/health', timeout=4)"
CMD ["sh", "-c", "exec python -m uvicorn server.app:create_app --factory --host 0.0.0.0 --port \"${PORT:-8000}\""]
